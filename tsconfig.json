{
  "compilerOptions": {
    "sourceMap": true,
    "target": "ES2015",
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "allowJs": false,
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strictPropertyInitialization": true,
    "jsx": "react-jsx"
  },
  "include": [
    "HintKeep/Client"
  ],
  "exclude": [
    "node_modules"
  ]
}