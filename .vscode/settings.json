{
    "files.watcherExclude": {
        "**/bin/**/*": true,
        "**/obj/**/*": true,
        "**/node_modules/**/*": true,
        "WebClient/**/*": true,
        "GraphQL/./data/**/*": true
    },
    "eslint.format.enable": true,
    "eslint.workingDirectories": [
        "WebClient"
    ],
    "cucumber.features": [
        "Features/**/*.feature"
    ],
    "cucumber.glue": [
        // "*specs*/**/*.cs",
        "WebClient/Features/**/*.feature.ts",
        "WebClient/Features/**/*.feature.tsx",
    ],
    "[typescript]": {
        "editor.indentSize": 4,
        "editor.detectIndentation": false,
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescriptreact]": {
        "editor.indentSize": 4,
        "editor.detectIndentation": false,
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    }
}